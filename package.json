{
  "name": "svft-discovery",
  "version": "0.1.0",
  "description": "Safe, bounded same-origin web discovery for security workflows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imshreevyas/svft-discovery.git"
  },
  "homepage": "https://github.com/imshreevyas/svft-discovery#readme",
  "bugs": {
    "url": "https://github.com/imshreevyas/svft-discovery/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js"
    }
  },
  "bin": {
    "svft": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:package": "pnpm build && node scripts/package-smoke.mjs",
    "test:watch": "vitest"
  },
  "keywords": [
    "security",
    "web-discovery",
    "url-discovery",
    "reconnaissance",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.0"
}
